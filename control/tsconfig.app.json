{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client", "w3c-web-serial", "wicg-file-system-access"],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    /**
     * The panel is written in TypeScript. JavaScript enters only through the tests that import the
     * generator of the protocol sources (tools/*.mjs), which tsconfig.tools.json checks with the
     * settings of Node; here only its types are read.
     */
    "allowJs": true,
    "checkJs": false,
    "moduleDetection": "force",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  // The service worker runs in another global scope; tsconfig.worker.json checks it.
  "exclude": ["src/service-worker.ts"]
}
