    "formatDefects": [
      { "name": "shorterThanHeader", "detail": "shorter than the header" },
      { "name": "lengthMismatch", "detail": "length does not match the header" },
      { "name": "badMagic", "detail": "bad magic number" },
      { "name": "badFlags", "detail": "flags are not 0" },
      { "name": "factoryVersion", "detail": "version 0" },
      { "name": "programLengthOutOfRange", "detail": "program length out of range" }
    ]
  },
  "virtualMachine": {
    "programCapacity": 1024,
    "registerCount": 4,
    "registerValue": { "minimum": -2147483648, "maximum": 4294967295 },
    "instructionsPerPoll": 64,
    "restartDelayMilliseconds": 10000,
    "minimumPrintIntervalMilliseconds": 100,
    "returnStackDepth": 8,
    "operandForms": [
      { "name": "none", "length": 1 },
      { "name": "register", "length": 2 },
      { "name": "register-immediate", "length": 6 },
      { "name": "register-register", "length": 3 },
      { "name": "immediate", "length": 5 },
      { "name": "address", "length": 3 },
      { "name": "register-address", "length": 4 }
    ],
    "instructionEffects": [
      { "name": "halt", "forms": ["none"] },
      { "name": "print", "forms": ["register"] },
      { "name": "write", "forms": ["register", "register-immediate", "register-register"] },
      { "name": "divide", "forms": ["register-immediate", "register-register"] },
      { "name": "sleep", "forms": ["immediate"] },
      { "name": "jump", "forms": ["address"] },
      { "name": "branch", "forms": ["register-address"] },
      { "name": "call", "forms": ["address"] },
      { "name": "return", "forms": ["none"] },
      { "name": "pin-mode", "forms": ["register-register"] },
      { "name": "pin-read", "forms": ["register-register"] },
      { "name": "pin-write", "forms": ["register-register"] }
    ],
    "instructions": [
      { "mnemonic": "HALT", "identifier": "Halt", "opcode": "0x00", "form": "none", "effect": "halt" },
      { "mnemonic": "PRINT", "identifier": "Print", "opcode": "0x01", "form": "register", "effect": "print" },
      { "mnemonic": "LOAD", "identifier": "Load", "opcode": "0x02", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "SLEEP", "identifier": "Sleep", "opcode": "0x03", "form": "immediate", "effect": "sleep" },
      { "mnemonic": "ADDI", "identifier": "AddImmediate", "opcode": "0x10", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "ADDR", "identifier": "AddRegister", "opcode": "0x11", "form": "register-register", "effect": "write" },
      { "mnemonic": "SUBI", "identifier": "SubtractImmediate", "opcode": "0x12", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "SUBR", "identifier": "SubtractRegister", "opcode": "0x13", "form": "register-register", "effect": "write" },
      { "mnemonic": "MULI", "identifier": "MultiplyImmediate", "opcode": "0x14", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "MULR", "identifier": "MultiplyRegister", "opcode": "0x15", "form": "register-register", "effect": "write" },
      { "mnemonic": "DIVI", "identifier": "DivideImmediate", "opcode": "0x16", "form": "register-immediate", "effect": "divide" },
      { "mnemonic": "DIVR", "identifier": "DivideRegister", "opcode": "0x17", "form": "register-register", "effect": "divide" },
      { "mnemonic": "MODI", "identifier": "ModuloImmediate", "opcode": "0x18", "form": "register-immediate", "effect": "divide" },
      { "mnemonic": "MODR", "identifier": "ModuloRegister", "opcode": "0x19", "form": "register-register", "effect": "divide" },
      { "mnemonic": "ANDI", "identifier": "AndImmediate", "opcode": "0x20", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "ANDR", "identifier": "AndRegister", "opcode": "0x21", "form": "register-register", "effect": "write" },
      { "mnemonic": "ORI", "identifier": "OrImmediate", "opcode": "0x22", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "ORR", "identifier": "OrRegister", "opcode": "0x23", "form": "register-register", "effect": "write" },
      { "mnemonic": "XORI", "identifier": "ExclusiveOrImmediate", "opcode": "0x24", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "XORR", "identifier": "ExclusiveOrRegister", "opcode": "0x25", "form": "register-register", "effect": "write" },
      { "mnemonic": "SHLI", "identifier": "ShiftLeftImmediate", "opcode": "0x26", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "SHLR", "identifier": "ShiftLeftRegister", "opcode": "0x27", "form": "register-register", "effect": "write" },
      { "mnemonic": "SHRI", "identifier": "ShiftRightImmediate", "opcode": "0x28", "form": "register-immediate", "effect": "write" },
      { "mnemonic": "SHRR", "identifier": "ShiftRightRegister", "opcode": "0x29", "form": "register-register", "effect": "write" },
      { "mnemonic": "NOT", "identifier": "Not", "opcode": "0x2A", "form": "register", "effect": "write" },
      { "mnemonic": "JMP", "identifier": "Jump", "opcode": "0x30", "form": "address", "effect": "jump" },
      { "mnemonic": "JZ", "identifier": "JumpIfZero", "opcode": "0x31", "form": "register-address", "effect": "branch" },
      { "mnemonic": "JNZ", "identifier": "JumpIfNotZero", "opcode": "0x32", "form": "register-address", "effect": "branch" },
      { "mnemonic": "JNEG", "identifier": "JumpIfNegative", "opcode": "0x33", "form": "register-address", "effect": "branch" },
