  "radio": {
    "frequencyMegahertz": { "minimum": 915.0, "maximum": 928.0, "default": 915.9, "rangeDecimals": 1 },
    "spreadingFactor": { "minimum": 7, "maximum": 12, "default": 7 },
    "bandwidthsKilohertz": [125, 250, 500],
    "defaultBandwidthKilohertz": 500,
    "codingRateDenominator": { "minimum": 5, "maximum": 8, "default": 5 },
    "preambleLength": { "minimum": 6, "maximum": 65535, "default": 8 },
    "syncWord": { "minimum": 0, "maximum": 255, "default": "0x12" },
    "defaultTransmitPowerDbm": 4,
    "defaultLnaMode": "bypass",
    "settingKeys": ["freq", "sf", "bw", "cr", "preamble", "sync", "power", "lna"],
    "onAir": {
      "bandwidthKilohertz": 500,
      "maximumPowerDbm": 26,
      "minimumCenterMegahertz": 915.25,
      "maximumCenterMegahertz": 927.75
    }
  },
  "console": {
    "baudRate": 921600,
    "lineCapacity": 200,
    "imageLine": {
      "hexadecimalDigitsPerByte": 2,
      "commandWordAllowance": 32
    },
    "webSocket": {
      "host": "192.168.4.1",
      "path": "/console"
    },
    "accessPointNamePrefix": "J5-",
    "errorCommandWordLength": 15,
    "commandPreconditions": [
      {
        "name": "rejectedDuringRun",
        "description": "no run of the node is in progress",
        "refusal": { "reason": "busy", "detail": null }
      },
      {
        "name": "rejectedDuringEcho",
        "description": "no echo of the node waits for its reply",
        "refusal": { "reason": "busy", "detail": null }
      },
      {
        "name": "needsRadio",
        "description": "the radio started at boot",
        "refusal": { "reason": "radio_failure", "detail": "radio not started" }
      }
    ],
    "commands": [
      {
        "name": "help",
        "usage": "help",
        "forms": [{ "action": "listCommands", "arguments": [0, 0] }]
      },
      {
        "name": "status",
        "usage": "status",
        "forms": [{ "action": "reportStatus", "arguments": [0, 0] }]
      },
      {
        "name": "radio",
        "usage": "radio | radio reset | radio <key> <value> ... (freq sf bw cr preamble sync power lna)",
        "forms": [
          { "action": "reportRadio", "arguments": [0, 0] },
          {
            "action": "resetRadio",
            "selector": "reset",
            "arguments": [1, 1],
            "preconditions": ["rejectedDuringRun", "needsRadio"]
          },
          {
            "action": "changeRadio",
            "arguments": [1, "settingKeyPairs"],
            "preconditions": ["rejectedDuringRun", "needsRadio"]
          }
        ]
      },
      {
        "name": "echo",
        "usage": "echo <id> [size]",
        "forms": [
          {
            "action": "requestEcho",
            "arguments": [1, 2],
            "preconditions": ["rejectedDuringRun", "rejectedDuringEcho", "needsRadio"]
          }
        ]
      },
      {
        "name": "run",
        "usage": "run <count> <size> <interval_ms> | run stop",
        "forms": [
          { "action": "stopRun", "selector": "stop", "arguments": [1, 1] },
          {
            "action": "startRun",
            "arguments": [3, 3],
            "preconditions": ["rejectedDuringRun", "rejectedDuringEcho", "needsRadio"]
          }
        ]
      },
      {
        "name": "wifi",
        "usage": "wifi on|off",
        "forms": [
          { "action": "enableWireless", "selector": "on", "arguments": [1, 1] },
          { "action": "disableWireless", "selector": "off", "arguments": [1, 1] }
        ]
      },
      {
        "name": "resend",
        "usage": "resend",
        "forms": [
          {
            "action": "resendLastFrame",
            "arguments": [0, 0],
            "preconditions": ["rejectedDuringRun", "needsRadio"]
          }
        ]
      },
      {
        "name": "presence",
        "usage": "presence on | presence off <seconds>",
        "forms": [
          { "action": "releasePresence", "selector": "on", "arguments": [1, 1] },
          { "action": "holdPresence", "selector": "off", "arguments": [2, 2] }
        ]
      },
      {
        "name": "load_registers",
        "usage": "load_registers <r1> <r2> <r3> <r4>",
        "forms": [{ "action": "loadRegisters", "arguments": ["registerCount", "registerCount"] }]
      },
      {
        "name": "load_image",
        "usage": "load_image <hex>",
        "carriesImage": true,
        "forms": [{ "action": "loadImage", "arguments": [1, 1] }]
      },
      {
        "name": "activate",
        "usage": "activate <version>",
        "forms": [{ "action": "activateAvailableVersion", "arguments": [1, 1] }]
      },
      {
        "name": "fragment_size",
        "usage": "fragment_size [bytes]",
        "forms": [{ "action": "changeFragmentSize", "arguments": [0, 1] }]
      },
      {
        "name": "program",
        "usage": "program",
        "forms": [{ "action": "reportProgram", "arguments": [0, 0] }]
      }
    ],
    "decimals": {
      "rssi": 1,
      "snr": 2,
      "frequency": 3,
      "packetDeliveryRatio": 4
    }
  },
  "timings": {
    "helloPeriodMilliseconds": 10000,
    "helloJitterMilliseconds": 2000,
    "firstHelloMinimumDelayMilliseconds": 1000,
    "firstHelloMaximumDelayMilliseconds": 3000,
    "neighborExpiry": { "milliseconds": 60000, "expiresAtBoundary": true },
    "minimumPresenceHoldSeconds": 1,
